<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Blind Tasting Pro - Flexible Scorer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        .ios-blur { backdrop-filter: blur(10px); background: rgba(255,255,255,0.8); }
        input[type="number"]::-webkit-inner-spin-button { display: none; }
    </style>
</head>
<body class="bg-[#F8F7F2] text-slate-900 pb-32">

    <header class="sticky top-0 z-50 p-4 border-b bg-white flex justify-between items-center shadow-sm">
        <div>
            <h1 class="text-xl font-black italic tracking-tighter">BLIND TASTING <span class="text-red-700">斷鳩</span></h1>
            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Advanced Scorer Mode</p>
        </div>
        <div id="total-points-badge" class="bg-black text-white px-3 py-1 rounded-full text-xs font-bold">
            0 PTS
        </div>
    </header>

    <main class="max-w-md mx-auto p-4 space-y-6">

        <section class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
            <div class="flex items-center gap-2 mb-4">
                <i data-lucide="settings-2" class="w-5 h-5 text-red-700"></i>
                <h2 class="font-bold text-lg">Scoring Setup</h2>
            </div>

            <div id="scoring-configs" class="space-y-4">
                </div>
        </section>

        <section class="space-y-4">
            <h2 class="text-xs font-black text-slate-400 uppercase tracking-widest ml-1">Player Guess Preview</h2>
            
            <div id="player-form" class="space-y-3">
                </div>
        </section>

    </main>

    <div class="fixed bottom-0 left-0 right-0 p-4 bg-white/80 backdrop-blur-md border-t border-slate-200">
        <div class="max-w-md mx-auto flex gap-3">
            <button class="flex-1 bg-black text-white py-4 rounded-2xl font-bold flex items-center justify-center gap-2 shadow-lg active:scale-95 transition-transform">
                <i data-lucide="share-2" class="w-5 h-5"></i>
                Post to GitHub
            </button>
        </div>
    </div>

    <script>
        // CORE STATE: This is the "Logic" the host controls
        const config = {
            categories: [
                { id: 'grape', label: '提子品種', pts: 20, enabled: true, bonus: false },
                { id: 'country', label: '國家', pts: 10, enabled: true, bonus: false },
                { id: 'region', label: '產區', pts: 20, enabled: true, bonus: true, bonusLabel: 'Village/Cru Bonus', bonusPts: 10 },
                { id: 'vintage', label: '年份', pts: 10, enabled: true, tolerance: 1 },
                { id: 'producer', label: '酒莊', pts: 20, enabled: true, bonus: false }
            ]
        };

        function renderApp() {
            const configContainer = document.getElementById('scoring-configs');
            const formContainer = document.getElementById('player-form');
            let totalPossible = 0;

            configContainer.innerHTML = '';
            formContainer.innerHTML = '';

            config.categories.forEach((cat, index) => {
                if (cat.enabled) totalPossible += cat.pts + (cat.bonus ? cat.bonusPts : 0);

                // Build Host UI
                const configItem = document.createElement('div');
                configItem.className = `p-3 rounded-xl border ${cat.enabled ? 'bg-slate-50 border-slate-200' : 'bg-slate-100 opacity-50'}`;
                configItem.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="font-bold text-sm">${cat.label}</span>
                        <div class="flex items-center gap-2">
                            <input type="number" onchange="updatePts(${index}, this.value)" value="${cat.pts}" class="w-12 text-center font-mono text-sm border rounded p-1">
                            <input type="checkbox" onchange="toggleCat(${index})" ${cat.enabled ? 'checked' : ''} class="w-5 h-5 accent-red-700">
                        </div>
                    </div>
                    ${cat.bonus !== undefined ? `
                        <div class="mt-2 pt-2 border-t flex items-center gap-2">
                            <input type="checkbox" onchange="toggleBonus(${index})" ${cat.bonus ? 'checked' : ''} id="b-${index}">
                            <label for="b-${index}" class="text-[11px] font-medium text-slate-500 uppercase">Enable ${cat.bonusLabel} (+${cat.bonusPts}pts)</label>
                        </div>
                    ` : ''}
                `;
                configContainer.appendChild(configItem);

                // Build Player UI Preview
                if (cat.enabled) {
                    const field = document.createElement('div');
                    field.innerHTML = `
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 ml-1">${cat.label} (${cat.pts}pts)</label>
                        <input type="text" placeholder="Your guess..." class="w-full p-4 rounded-xl border-2 border-white shadow-sm focus:border-red-700 transition-all outline-none">
                        ${cat.bonus ? `
                            <input type="text" placeholder="${cat.bonusLabel} (+${cat.bonusPts})" class="w-full mt-2 p-3 rounded-xl border-2 border-dashed border-red-200 bg-red-50/50 text-sm italic">
                        ` : ''}
                    `;
                    formContainer.appendChild(field);
                }
            });

            document.getElementById('total-points-badge').innerText = `${totalPossible} MAX PTS`;
            lucide.createIcons();
        }

        // LOGIC FUNCTIONS
        function updatePts(index, val) {
            config.categories[index].pts = parseInt(val) || 0;
            renderApp();
        }

        function toggleCat(index) {
            config.categories[index].enabled = !config.categories[index].enabled;
            renderApp();
        }

        function toggleBonus(index) {
            config.categories[index].bonus = !config.categories[index].bonus;
            renderApp();
        }

        // Initialize
        renderApp();
    </script>
</body>
</html>
